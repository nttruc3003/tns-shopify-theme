                  </svg>
                </a>
              {% endif %}

              {% if block.settings.social_twitter != blank %}
                <a
                  href="{{ block.settings.social_twitter }}"
                  class="ai-custom-footer-social-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Twitter"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                  </svg>
                </a>
              {% endif %}

              {% if block.settings.social_youtube != blank %}
                <a
                  href="{{ block.settings.social_youtube }}"
                  class="ai-custom-footer-social-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="YouTube"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </a>
              {% endif %}

              {% if block.settings.social_tiktok != blank %}
                <a
                  href="{{ block.settings.social_tiktok }}"
                  class="ai-custom-footer-social-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="TikTok"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                  </svg>
                </a>
              {% endif %}

              {% if block.settings.social_pinterest != blank %}
                <a
                  href="{{ block.settings.social_pinterest }}"
                  class="ai-custom-footer-social-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Pinterest"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.column_1_heading != blank %}
        <div class="ai-custom-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-custom-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
          <ul class="ai-custom-footer-links-{{ ai_gen_id }}">
            {% if block.settings.column_1_link_1_text != blank and block.settings.column_1_link_1_url != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_1_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_1_link_2_text != blank and block.settings.column_1_link_2_url != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_2_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_1_link_3_text != blank and block.settings.column_1_link_3_url != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_3_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_1_link_4_text != blank and block.settings.column_1_link_4_url != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_4_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_4_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_1_link_5_text != blank and block.settings.column_1_link_5_url != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_5_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_5_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.column_2_heading != blank %}
        <div class="ai-custom-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-custom-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
          <ul class="ai-custom-footer-links-{{ ai_gen_id }}">
            {% if block.settings.column_2_link_1_text != blank and block.settings.column_2_link_1_url != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_1_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_2_link_2_text != blank and block.settings.column_2_link_2_url != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_2_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_2_link_3_text != blank and block.settings.column_2_link_3_url != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_3_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_2_link_4_text != blank and block.settings.column_2_link_4_url != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_4_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_4_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_2_link_5_text != blank and block.settings.column_2_link_5_url != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_5_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_5_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.column_3_heading != blank %}
        <div class="ai-custom-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-custom-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
          <ul class="ai-custom-footer-links-{{ ai_gen_id }}">
            {% if block.settings.column_3_link_1_text != blank and block.settings.column_3_link_1_url != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_1_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_3_link_2_text != blank and block.settings.column_3_link_2_url != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_2_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_3_link_3_text != blank and block.settings.column_3_link_3_url != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_3_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_3_link_4_text != blank and block.settings.column_3_link_4_url != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_4_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_4_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_3_link_5_text != blank and block.settings.column_3_link_5_url != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_5_url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_5_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_copyright %}
      <div class="ai-custom-footer-bottom-{{ ai_gen_id }}">
        <p class="ai-custom-footer-copyright-{{ ai_gen_id }}">
          {{ block.settings.copyright_text }}
        </p>
      </div>
    {% endif %}
  </div>
</custom-footer-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomFooter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const currentYear = new Date().getFullYear();
        const copyrightText = this.querySelector('.ai-custom-footer-copyright-{{ ai_gen_id }}');
        if (copyrightText && copyrightText.textContent.includes('{year}')) {
          copyrightText.textContent = copyrightText.textContent.replace('{year}', currentYear);
        }
      }
    }

    customElements.define('custom-footer-{{ ai_gen_id }}', CustomFooter{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Custom footer",
  "tag": null,
  "class": "custom-footer-block",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
