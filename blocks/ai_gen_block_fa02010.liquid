{% doc %}
  @prompt
    Create a custom footer section called "Custom Footer" that can be added to individual pages (not global). It should include: editable columns with heading and links, social media icons, copyright text, and a logo image field. The section should be fully customizable through the theme editor settings with blocks for each column of links. Style it to look like a professional footer with a dark background option.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-custom-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-custom-footer-top-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: 40px;
    padding-bottom: {{ block.settings.section_spacing }}px;
    {% if block.settings.show_divider %}
      border-bottom: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
    {% endif %}
  }

  .ai-custom-footer-logo-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-custom-footer-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-custom-footer-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-custom-footer-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-custom-footer-logo-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    opacity: 0.3;
  }

  .ai-custom-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-custom-footer-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    text-transform: {{ block.settings.heading_transform }};
    margin: 0 0 8px 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-custom-footer-links-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-custom-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    transition: color 0.3s ease;
    display: inline-block;
  }

  .ai-custom-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-custom-footer-social-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-custom-footer-social-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    background-color: {{ block.settings.social_bg_color }};
    color: {{ block.settings.social_icon_color }};
    border-radius: {{ block.settings.social_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-custom-footer-social-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.social_bg_hover_color }};
    color: {{ block.settings.social_icon_hover_color }};
    transform: translateY(-2px);
  }

  .ai-custom-footer-social-link-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.social_icon_size }}px * 0.5);
    height: calc({{ block.settings.social_icon_size }}px * 0.5);
    fill: currentColor;
  }

  .ai-custom-footer-bottom-{{ ai_gen_id }} {
    padding-top: {{ block.settings.section_spacing }}px;
    text-align: {{ block.settings.copyright_alignment }};
  }

  .ai-custom-footer-copyright-{{ ai_gen_id }} {
    font-size: {{ block.settings.copyright_size }}px;
    color: {{ block.settings.copyright_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-footer-top-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-custom-footer-bottom-{{ ai_gen_id }} {
      text-align: center;
    }
  }
{% endstyle %}

<custom-footer-{{ ai_gen_id }} class="ai-custom-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-footer-container-{{ ai_gen_id }}">
    <div class="ai-custom-footer-top-{{ ai_gen_id }}">
      {% if block.settings.show_logo %}
        <div class="ai-custom-footer-logo-column-{{ ai_gen_id }}">
          {% if block.settings.logo %}
            <div class="ai-custom-footer-logo-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.logo | image_url: width: 400 }}"
                alt="{{ shop.name }}"
                loading="lazy"
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
              >
            </div>
          {% else %}
            <div class="ai-custom-footer-logo-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.show_social %}
            <div class="ai-custom-footer-social-{{ ai_gen_id }}">
              {% if block.settings.social_facebook != blank %}
                <a
                  href="{{ block.settings.social_facebook }}"
                  class="ai-custom-footer-social-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Facebook"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/>
                  </svg>
                </a>
              {% endif %}

              {% if block.settings.social_instagram != blank %}
                <a
                  href="{{ block.settings.social_instagram }}"
                  class="ai-custom-footer-social-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Instagram"
