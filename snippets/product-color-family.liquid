{%- comment -%}
  Color Family Switcher block.
  Shows a grid of other products in the same "color family" (a Shopify Collection).
  Data is loaded client-side via the Storefront API.

  Requires:
    - product.metafields.custom.color_family — Collection reference
    - shop.metafields.custom.storefront_token — Storefront API public access token

  Renders nothing if either is missing.
{%- endcomment -%}

{%- liquid
  assign family_collection = product.metafields.custom.color_family.value
  assign storefront_token = shop.metafields.custom.storefront_token.value
  if storefront_token == blank
    assign storefront_token = shop.metafields.custom.storefront_token
  endif
  assign family_total = 0
  assign family_tags_json = '[]'
  if family_collection != blank
    assign family_total = family_collection.products_count
    if family_total == 0
      assign family_total = family_collection.all_products_count
    endif
    assign family_tags_meta = family_collection.metafields.custom.color_family_tags.value
    if family_tags_meta != blank
      assign family_tags_json = family_tags_meta | json
    endif
  endif
-%}

{%- if family_collection != blank and storefront_token != blank -%}
<section class="color-family-switcher"
         data-cf-block
         data-cf-current-id="{{ product.id }}"
         data-cf-current-handle="{{ product.handle }}">

  <header class="color-family-switcher__header">
    <div class="color-family-switcher__heading">
      <div class="color-family-switcher__eyebrow">Shop the Family</div>
      <h2 class="color-family-switcher__title">
        {{ family_collection.title }}
        <span class="color-family-switcher__meta">
          · <span data-cf-total>{{ family_total }}</span> shades<span data-cf-in-cart-summary hidden></span>
        </span>
      </h2>
    </div>
    <a href="{{ family_collection.url }}" class="color-family-switcher__view-all">
      View all <span aria-hidden="true">→</span>
    </a>
  </header>

  <div class="color-family-switcher__search">
    <span class="color-family-switcher__search-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </span>
    <input type="search"
           class="color-family-switcher__input"
           data-cf-input
           placeholder="Search by color number or name"
           aria-label="Search shades in {{ family_collection.title | escape }}">
    <div class="color-family-switcher__search-actions">
      <button type="button" class="color-family-switcher__clear" data-cf-clear hidden aria-label="Clear search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <span class="color-family-switcher__count" data-cf-count></span>
    </div>
  </div>

  <div class="color-family-switcher__active">
    <div class="color-family-switcher__active-pill">
      <div class="color-family-switcher__active-thumb">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 88 }}" alt="" loading="lazy" width="22" height="22">
        {%- endif -%}
      </div>
      <div class="color-family-switcher__active-text">
        <span class="color-family-switcher__active-eyebrow">You're viewing</span>
        <span class="color-family-switcher__active-name">{{ product.title }}</span>
      </div>
      <span class="color-family-switcher__active-cart" data-cf-active-cart hidden>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/>
        </svg>
        <span data-cf-active-cart-qty>0</span>&nbsp;in cart
      </span>
    </div>
  </div>

  <div class="color-family-switcher__toolbar" data-cf-toolbar hidden>
    <label class="color-family-switcher__hide-oos">
      <input type="checkbox" data-cf-hide-oos>
      Hide out of stock&nbsp;<span data-cf-oos-count></span>
    </label>
  </div>

  <ul class="color-family-switcher__grid" data-cf-grid aria-busy="true">
    {%- for i in (1..12) -%}
      <li class="color-family-switcher__skeleton" aria-hidden="true"></li>
    {%- endfor -%}
  </ul>

  <footer class="color-family-switcher__footer" data-cf-footer hidden>
    <div class="color-family-switcher__range">
      <strong data-cf-range>1–20</strong> of <span data-cf-total-foot>0</span>
    </div>
    <nav class="color-family-switcher__pagination" data-cf-pagination aria-label="Pagination"></nav>
  </footer>

  <noscript>
    <p class="color-family-switcher__noscript">
      <a href="{{ family_collection.url }}">Browse all {{ family_total }} shades in {{ family_collection.title }} →</a>
    </p>
  </noscript>

  <script type="application/json" data-cf-config>
    {
      "collectionHandle": {{ family_collection.handle | json }},
      "currentProductId": {{ product.id | json }},
      "currentHandle": {{ product.handle | json }},
      "familyName": {{ family_collection.title | json }},
      "familyUrl": {{ family_collection.url | json }},
      "familyTotal": {{ family_total | json }},
      "familyTags": {{ family_tags_json }},
      "shopDomain": {{ shop.permanent_domain | json }},
      "storefrontToken": {{ storefront_token | json }},
      "apiVersion": "2024-10",
      "pageSize": 20
    }
  </script>

  <script src="{{ 'product-color-family.js' | asset_url }}" defer></script>
</section>
{%- endif -%}
