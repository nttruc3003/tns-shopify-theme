<script>
(function () {
  var rootDomain = 'teamnailsupply.com';
  var affiliateMap = {
    'hoaitam.teamnailsupply.com': 'hoaitam',
    'rockydinh.teamnailsupply.com': 'rockydinh',
    'quangdo.teamnailsupply.com': 'quangdo',
    'thuannguyen.teamnailsupply.com': 'thuannguyen',
    'nhanly.teamnailsupply.com': 'nhanly',
    'khangduong.teamnailsupply.com': 'khangduong',
    'cherrynailartist.teamnailsupply.com': 'cherrybynails',
    'toannguyen.teamnailsupply.com': 'toannguyen',
    'yaoyao.teamnailsupply.com': 'yaoyao',
    'henry.teamnailsupply.com': 'henry',
    'loinguyen.teamnailsupply.com': 'loinguyen',
    'khangnguyen.teamnailsupply.com': 'khangnguyen',
    'jtr.teamnailsupply.com': 'justin',
    'tuantruong.teamnailsupply.com': 'tuantruong',
    'kimphuong.teamnailsupply.com': 'kimphuong'
  };

  function setCookie(name, value, days) {
    var expires = new Date();
    expires.setTime(expires.getTime() + days * 24 * 60 * 60 * 1000);
    document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires.toUTCString() + '; path=/; domain=.' + rootDomain + '; SameSite=Lax; Secure';
  }

  function getKolIdFromHost(host) {
    if (!host || !host.endsWith('.' + rootDomain)) return null;
    if (host === rootDomain || host === 'www.' + rootDomain) return null;

    var subdomain = host.slice(0, -1 * (rootDomain.length + 1));
    if (!/^[a-z0-9_-]{2,30}$/.test(subdomain) || subdomain === 'www') return null;

    return affiliateMap[host] || subdomain;
  }

  function isPrimaryHost(host) {
    return host === rootDomain || host === 'www.' + rootDomain;
  }

  async function syncCartAttributes(attrs) {
    var syncKey = 'kol_synced_' + (attrs.kol_id || attrs.affiliate || '');
    if (sessionStorage.getItem(syncKey) === '1') return;

    var cart = await fetch('/cart.js', { credentials: 'same-origin' }).then(function (response) {
      return response.json();
    });
    cart.attributes = cart.attributes || {};

    var hasChanges = Object.keys(attrs).some(function (key) {
      return (cart.attributes[key] || '') !== (attrs[key] || '');
    });

    if (hasChanges) {
      await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ attributes: attrs })
      });
    }

    sessionStorage.setItem(syncKey, '1');
  }

  var host = (location.hostname || '').toLowerCase();
  var kolId = getKolIdFromHost(host);
  var attrs;

  if (kolId) {
    setCookie('kol_first', kolId, 30);
    setCookie('kol_last', kolId, 30);
    setCookie('kol_ts', String(Date.now()), 30);

    attrs = {
      kol_id: kolId,
      kol_first: kolId,
      kol_last: kolId,
      kol_host: host
    };

    if (affiliateMap[host]) {
      attrs.affiliate = affiliateMap[host];
    }

    syncCartAttributes(attrs).catch(function () {});
    return;
  }

  if (isPrimaryHost(host)) {
    syncCartAttributes({
      kol_id: '',
      kol_first: '',
      kol_last: '',
      kol_host: host
    }).catch(function () {});
  }
})();
</script>
